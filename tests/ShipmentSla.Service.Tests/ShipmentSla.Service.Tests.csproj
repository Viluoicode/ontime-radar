<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the AWS-facing code (ShipmentStore, Processor, API filters / endpoints).
       AWS is replaced by in-memory fakes (FakeDynamoTable) and NSubstitute: no AWS account, no Docker. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    <PackageReference Include="NSubstitute" Version="5.*" />
    <PackageReference Include="Amazon.Lambda.TestUtilities" Version="2.*" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ShipmentSla.Api\ShipmentSla.Api.csproj" />
    <ProjectReference Include="..\..\src\ShipmentSla.Processor\ShipmentSla.Processor.csproj" />
    <ProjectReference Include="..\..\src\ShipmentSla.Infrastructure\ShipmentSla.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ShipmentSla.Replayer\ShipmentSla.Replayer.csproj" />
  </ItemGroup>
</Project>
